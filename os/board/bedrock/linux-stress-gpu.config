# GPU stress (x86_64 only). Graphics drivers are modules that bedrock-gpu loads on
# demand, so boot and the console stay on the firmware framebuffer until then.
CONFIG_MODULES=y
CONFIG_DRM=m
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
# Mesa creates anonymous shared files (memfd)
CONFIG_TMPFS=y
# Firmware and libraries make the initramfs large: store it uncompressed and let
# the xz-compressed kernel image carry it (one compression pass, not two).
# INITRAMFS_SOURCE is repeated from Buildroot's own fixup so the choice below is
# visible when the fragment is merged.
CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# Graphics firmware is stored xz-compressed (post-build.sh) to keep it small in RAM.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
