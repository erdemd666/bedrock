# Fleet mode: IPv4 over a wired NIC, so a PC booted from the network can send its
# record to the fleet server. Common drivers for both builds; the rest is in
# linux-fleet-i686.config and linux-fleet-x86_64.config.
CONFIG_NET=y
CONFIG_INET=y
# DHCP (BusyBox udhcpc) talks to raw packet sockets.
CONFIG_PACKET=y
# CONFIG_IPV6 is not set
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
# r8169 loads its firmware from /lib/firmware (linux-firmware, rtl_nic).
CONFIG_FW_LOADER=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139TOO=y
CONFIG_R8169=y
