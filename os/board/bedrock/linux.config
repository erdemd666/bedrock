# Bedrock kernel, shared by i686 and x86_64. Everything built in, no modules,
# no networking. Options not listed take their Kconfig default.
CONFIG_LOCALVERSION="-bedrock"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="bedrock"
# CONFIG_SWAP is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SMP=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y
CONFIG_X86_MCELOG_LEGACY=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_DMI=y
CONFIG_DMI_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Disks: IDE/PATA, SATA (AHCI and pre-AHCI), NVMe, USB storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_NV=y
CONFIG_SATA_SIL=y
CONFIG_SATA_SIS=y
CONFIG_SATA_VIA=y
CONFIG_PATA_ALI=y
CONFIG_PATA_AMD=y
CONFIG_PATA_ATIIXP=y
CONFIG_PATA_JMICRON=y
CONFIG_PATA_SIS=y
CONFIG_PATA_VIA=y
CONFIG_ATA_GENERIC=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y

# Keyboards: PS/2 (default) and USB HID
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Consoles: VGA text, framebuffers from firmware, serial
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Sensors, SPD over SMBus, RTC
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=y
CONFIG_SENSORS_K10TEMP=y
CONFIG_SENSORS_IT87=y
CONFIG_SENSORS_NCT6775=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_I801=y
CONFIG_I2C_PIIX4=y
CONFIG_I2C_VIAPRO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y

# Report partition on the stick
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Silent boot: no decompressor messages, no boot logo
# CONFIG_X86_VERBOSE_BOOTUP is not set
# CONFIG_LOGO is not set

# Suspend-to-RAM: the wipe tool unfreezes ATA drives with a suspend/resume cycle.
# VT_CONSOLE_SLEEP (default with these) redraws the console on resume.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI_SLEEP=y
