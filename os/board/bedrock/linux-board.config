# Motherboard diagnosis: hardware error reporting and board sensors.
# X86_MCE (Intel, AMD), CORETEMP, K10TEMP, IT87, NCT6775 are in linux.config.
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_RAS=y
# Errors the firmware reports itself (APEI GHES), common on business machines
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_EDAC=y
CONFIG_EDAC_GHES=y
# AMD: human-readable machine checks (bank type from IPID), memory controllers
CONFIG_EDAC_DECODE_MCE=y
CONFIG_EDAC_AMD64=y
# Intel desktop and workstation memory controllers; the 64-bit-only ones
# (IGEN6, SBRIDGE) drop out of the i686 build by their own dependencies.
CONFIG_EDAC_I82975X=y
CONFIG_EDAC_I3000=y
CONFIG_EDAC_I3200=y
CONFIG_EDAC_X38=y
CONFIG_EDAC_IE31200=y
CONFIG_EDAC_I7CORE=y
CONFIG_EDAC_SBRIDGE=y
CONFIG_EDAC_IGEN6=y
# Super I/O chips and ACPI/WMI sensor interfaces
CONFIG_SENSORS_W83627HF=y
CONFIG_SENSORS_W83627EHF=y
CONFIG_SENSORS_F71882FG=y
CONFIG_SENSORS_K8TEMP=y
CONFIG_SENSORS_ATK0110=y
CONFIG_ACPI_WMI=y
CONFIG_SENSORS_ASUS_WMI=y
